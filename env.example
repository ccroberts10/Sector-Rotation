# Required
TRADIER_TOKEN=your_tradier_production_token_here
PUSHOVER_TOKEN=your_pushover_app_token_here
PUSHOVER_USER=your_pushover_user_key_here

# Optional - enables 2-3 sentence AI recap at top of each alert
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Optional
# Run a scan immediately on service boot (useful for testing). Default: false
RUN_ON_BOOT=false

# Railway sets this automatically
# PORT=3000
